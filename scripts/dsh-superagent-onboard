def agent_wrapper(person_home, deployment_id, token, gh):
    path = person_home / "bin" / f"agent-{deployment_id}"
    return path, f"""#!/bin/sh
exec env GH_TOKEN={shlex.quote(token)} {shlex.quote(gh)} "$@"
"""


def create_person(login, base, dry):
    user, home, result = person_plan(login, base)
    if not dry:
        if subprocess.run(["getent", "passwd", user], capture_output=True).returncode != 0:
            run_checked(["useradd", "--system", "--user-group", "--home-dir", str(home), "--create-home",
                         "--shell", "/usr/sbin/nologin", user])
        for path in [home, home / "dsh-home", home / "deployments", home / "worktrees", home / "artifacts"]:
            path.mkdir(parents=True, exist_ok=True)
            shutil.chown(path, user=user, group=user)
        os.chmod(home, 0o700)
    return result


def create_model_proxy_user(login, base, dry):
    user, state, legacy, result = model_proxy_plan(login, base)
    if not dry:
        if subprocess.run(["getent", "passwd", user], capture_output=True).returncode != 0:
            run_checked(["useradd", "--system", "--user-group", "--home-dir", str(state), "--no-create-home",
                         "--shell", "/usr/sbin/nologin", user])
        state.mkdir(parents=True, exist_ok=True)
        shutil.chown(state, user=user, group=user)
        os.chmod(state, 0o700)
    return result


def chown_proxy_tree(root, user):
    for current, directories, files in os.walk(root):
        shutil.chown(current, user=user, group=user)
        os.chmod(current, 0o700)
        for name in directories:
            path = Path(current) / name
            shutil.chown(path, user=user, group=user)
            os.chmod(path, 0o700)
        for name in files:
            path = Path(current) / name
            shutil.chown(path, user=user, group=user)
            os.chmod(path, 0o600)


def backup_proxy_state(base, login, source):
    root = base / "backups" / "model-proxies"
    root.mkdir(parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    shutil.chown(root, user="root", group="root")
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    target = root / f"{login}-{stamp}"
    target.mkdir(mode=0o700)
    if source.exists():
        shutil.copytree(source, target / "state", symlinks=True)
    return target


def ensure_model_proxy(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    binary, start, end = model_proxy_config(request)
    user, state, legacy, plan = model_proxy_plan(login, base)
    unit_path = Path("/etc/systemd/system") / plan["unit"]
    lock = None if dry else model_proxy_lock(base)
    with nullcontext() if lock is None else lock:
        port = allocate_model_proxy_port(login, state, start, end)
        if dry:
            return {
                **plan,
                "port": port,
                "binary": str(binary),
                "unitContent": model_proxy_unit_content(user, binary, state, port),
            }

        create_model_proxy_user(login, base, False)
        if not binary.is_file() or not os.access(binary, os.X_OK):
            raise OnboardingError("model proxy binary is not executable")

        previous_unit = unit_path.read_bytes() if unit_path.exists() else None
        previous_active = subprocess.run(["systemctl", "is-active", plan["unit"]], capture_output=True).stdout.strip()
        backup = None
        migrated = False
        try:
            subprocess.run(["systemctl", "stop", plan["unit"]], check=False, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
            if legacy.exists() and legacy != state:
                backup = backup_proxy_state(base, login, legacy)
                if state.exists():
                    state_backup = backup / "existing-state"
                    shutil.copytree(state, state_backup, symlinks=True)
                    shutil.rmtree(state)
                shutil.move(str(legacy), str(state))
                migrated = True
            elif state.exists():
                backup = backup_proxy_state(base, login, state)

            state.mkdir(parents=True, exist_ok=True)
            (state / "auth").mkdir(parents=True, exist_ok=True)
            chown_proxy_tree(state, user)

            config_path = state / "config.yaml"
            if config_path.exists():
                data = yaml.safe_load(config_path.read_text()) or {}
                if not isinstance(data, dict):
                    raise OnboardingError("model proxy config must be a YAML mapping")
            else:
                data = {}
            management_secret_path = state / "management-secret"
            if management_secret_path.exists():
                management_secret = management_secret_path.read_text().strip()
            else:
                management_secret = secrets.token_urlsafe(48)
            remote = data.get("remote-management")
            if not isinstance(remote, dict):
                remote = {}
            remote.update({
                "allow-remote": False,
                "disable-control-panel": True,
                "secret-key": management_secret,
            })
            data.update({
                "host": "127.0.0.1",
                "port": port,
                "tls": {"enable": False, "cert": ""},
                "remote-management": remote,
                "auth-dir": str(state / "auth"),
            })
            data.setdefault("api-keys", [])
            write(config_path, yaml.safe_dump(data, sort_keys=False), user=user, group=user)
            write(management_secret_path, f"{management_secret}\n", mode=0o600, user="root", group="root")
            write(unit_path, model_proxy_unit_content(user, binary, state, port), mode=0o644)
            run_checked(["systemctl", "daemon-reload"])
            run_checked(["systemctl", "enable", "--now", plan["unit"]])
            deadline = time.monotonic() + 30
            while time.monotonic() < deadline:
                try:
                    management_request(state, "GET", "/config/access/api-keys", secret=management_secret)
                    break
                except OnboardingError:
                    time.sleep(0.5)
            else:
                raise OnboardingError("model proxy did not become healthy in time")
            return {**plan, "port": port, "binary": str(binary), "status": "ready",
                    "backup": str(backup) if backup is not None else None}
        except Exception:
            subprocess.run(["systemctl", "stop", plan["unit"]], check=False, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
            if backup is not None:
                if state.exists():
                    shutil.rmtree(state, ignore_errors=True)
                restored = backup / "state"
                if restored.exists():
                    destination = legacy if migrated else state
                    shutil.copytree(restored, destination, symlinks=True)
            if previous_unit is None:
                unit_path.unlink(missing_ok=True)
            else:
                unit_path.write_bytes(previous_unit)
                os.chmod(unit_path, 0o644)
            run_checked(["systemctl", "daemon-reload"])
            if previous_active == b"active":
                subprocess.run(["systemctl", "start", plan["unit"]], check=False, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
            raise


def management_request(state, method, suffix, body=None, secret=None):
    secret = secret or (state / "management-secret").read_text().strip()
    port = yaml.safe_load((state / "config.yaml").read_text())["port"]
    data = None if body is None else json.dumps(body).encode()
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}/v8/management{suffix}",
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {secret}",
            **({"Content-Type": "application/json"} if data is not None else {}),
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = response.read()
    except urllib.error.HTTPError as error:
        raise OnboardingError(f"model proxy management request failed with HTTP {error.code}") from error
    except (urllib.error.URLError, TimeoutError) as error:
        raise OnboardingError("model proxy management API is unavailable") from error
    if not payload:
        return None
    try:
        return json.loads(payload)
    except json.JSONDecodeError as error:
        raise OnboardingError("model proxy management API returned invalid JSON") from error


def model_proxy_status(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _binary, start, end = model_proxy_config(request)
    _user, state, _legacy, plan = model_proxy_plan(login, base)
    port = allocate_model_proxy_port(login, state, start, end)
    if dry:
        return {**plan, "status": "unchanged", "baseURL": f"http://127.0.0.1:{port}/v1",
                "providers": [], "deployments": []}
    active = systemctl_state(plan["unit"])
    if active != "active":
        return {**plan, "status": active, "baseURL": f"http://127.0.0.1:{port}/v1",
                "providers": [], "deployments": []}
    keys = management_request(state, "GET", "/config/access/api-keys")
    providers = management_request(state, "GET", "/config/api-keys/openai-compatibility") or []
    provider_names = {
        item.get("name"): bool(item.get("keys"))
        for item in providers
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }
    statuses = [
        {"id": "one-nexus", "label": "OneNexus",
         "state": "configured" if provider_names.get("one-nexus") else "missing"},
        {"id": "openai", "label": "OpenAI",
         "state": "configured" if provider_names.get("openai") else "missing"},
    ]
    auth_dir = state / "auth"
    auth = []
    if auth_dir.exists():
        for path in auth_dir.glob("*.json"):
            if path.name.startswith("._"):
                continue
            try:
                item = json.loads(path.read_text())
            except (OSError, json.JSONDecodeError):
                continue
            if item.get("type") != "claude" or item.get("disabled") is True:
                continue
            prefix = item.get("prefix")
            connected = bool(item.get("access_token"))
            if prefix == "nexus13":
                statuses.append({"id": "nexus13", "label": "Nexus13",
                                 "state": "connected" if connected else "sign-in-required"})
            else:
                statuses.append({"id": "claude", "label": "Claude",
                                 "state": "connected" if connected else "sign-in-required"})
            auth.append({"name": path.name, "provider": "nexus13" if prefix == "nexus13" else "claude",
                         "connected": connected})
    for provider in ("claude", "nexus13"):
        if not any(item["id"] == provider for item in statuses):
            statuses.append({"id": provider, "label": "Claude" if provider == "claude" else "Nexus13",
                             "state": "missing"})
    raw_ids = request.get("deploymentIds", [])
    if not isinstance(raw_ids, list):
        raise OnboardingError("deploymentIds must be a list")
    deployment_ids = sorted(
        deployment_id
        for deployment_id in raw_ids
        if isinstance(deployment_id, str)
        and ID.fullmatch(deployment_id) is not None
        and any(isinstance(key, str) and key.startswith(f"dsh-{deployment_id}-") for key in keys)
    )
    return {**plan, "status": "ready", "baseURL": f"http://127.0.0.1:{port}/v1", "providers": statuses,
            "deployments": [{"id": item, "keyConfigured": True} for item in deployment_ids],
            "authFiles": auth}


def claude_start(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    if dry:
        return {"status": "unchanged", "url": "https://claude.example/authorize", "state": "dry-state",
                "expiresAt": "2099-01-01T00:00:00Z"}
    response = management_request(state, "GET", "/oauth/auth-url?provider=claude")
    if not isinstance(response, dict) or response.get("status") != "ok" \
            or not isinstance(response.get("url"), str) or not isinstance(response.get("state"), str):
        raise OnboardingError("model proxy did not return a Claude login URL")
    return {"url": response["url"], "state": response["state"],
            "expiresAt": response.get("expires_at") or response.get("expiresAt")}


def claude_callback(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    state_token = require(request.get("state"), MODEL_PROXY_KEY, "OAuth state")
    code = request.get("code")
    error = request.get("error")
    if code is None and error is None:
        raise OnboardingError("OAuth callback needs code or error")
    if code is not None and (not isinstance(code, str) or not 1 <= len(code) <= 16_384):
        raise OnboardingError("invalid OAuth code")
    if error is not None and (not isinstance(error, str) or not 1 <= len(error) <= 1024):
        raise OnboardingError("invalid OAuth error")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    if dry:
        return {"accepted": True}
    body = {"provider": "claude", "state": state_token}
    if code is not None:
        body["code"] = code
    else:
        body["error"] = error
    management_request(state, "POST", "/oauth/callback", body)
    return {"accepted": True}


def claude_status(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    state_token = require(request.get("state"), MODEL_PROXY_KEY, "OAuth state")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    if dry:
        return {"status": "wait"}
    response = management_request(state, "GET", f"/oauth/status?{urllib.parse.urlencode({'state': state_token})}")
    if not isinstance(response, dict):
        raise OnboardingError("model proxy returned an invalid OAuth status")
    return response


def claude_cancel(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    state_token = require(request.get("state"), MODEL_PROXY_KEY, "OAuth state")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    if dry:
        return {"cancelled": True}
    response = management_request(
        state, "DELETE", f"/oauth/session?{urllib.parse.urlencode({'state': state_token})}")
    return {"cancelled": bool(response.get("cancelled", True)) if isinstance(response, dict) else True}


def deployment_key_create(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    value = f"dsh-{deployment_id}-{secrets.token_urlsafe(24)}"
    if dry:
        return {"id": deployment_id, "value": "dsh-widgets-dry-run"}
    keys = management_request(state, "GET", "/config/access/api-keys")
    if not isinstance(keys, list) or any(not isinstance(item, str) for item in keys):
        raise OnboardingError("model proxy returned an invalid client-key list")
    management_request(state, "PATCH", "/config/access/api-keys", [*keys, value])
    return {"id": deployment_id, "value": value}


def deployment_key_revoke(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    value = require(request.get("value"), MODEL_PROXY_KEY, "proxy key")
    if not value.startswith(f"dsh-{deployment_id}-"):
        raise OnboardingError("proxy key does not belong to the deployment")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    if dry:
        return {"id": deployment_id, "revoked": True}
    keys = management_request(state, "GET", "/config/access/api-keys")
    if not isinstance(keys, list) or any(not isinstance(item, str) for item in keys):
        raise OnboardingError("model proxy returned an invalid client-key list")
    management_request(state, "PATCH", "/config/access/api-keys", [item for item in keys if item != value])
    return {"id": deployment_id, "revoked": True}


def deployment_key_prune(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    keep = require(request.get("keep"), MODEL_PROXY_KEY, "proxy key")
    if not keep.startswith(f"dsh-{deployment_id}-"):
        raise OnboardingError("proxy key does not belong to the deployment")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    if dry:
        return {"id": deployment_id, "pruned": True}
    keys = management_request(state, "GET", "/config/access/api-keys")
    if not isinstance(keys, list) or any(not isinstance(item, str) for item in keys):
        raise OnboardingError("model proxy returned an invalid client-key list")
    if keep not in keys:
        raise OnboardingError("new deployment proxy key is not active")
    prefix = f"dsh-{deployment_id}-"
    remaining = [item for item in keys if not item.startswith(prefix)] + [keep]
    management_request(state, "PATCH", "/config/access/api-keys", remaining)
    return {"id": deployment_id, "pruned": True}


def provider_key_set(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    provider = request.get("provider")
    if provider not in MODEL_PROXY_PROVIDERS:
        raise OnboardingError("provider must be one-nexus or openai")
    api_key = request.get("apiKey")
    if not isinstance(api_key, str) or not 1 <= len(api_key) <= 16_384:
        raise OnboardingError("invalid provider API key")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    _user, state, _legacy, _plan = model_proxy_plan(login, base)
    if dry:
        return {"provider": provider, "configured": True}
    providers = management_request(state, "GET", "/config/api-keys/openai-compatibility") or []
    if not isinstance(providers, list) or any(not isinstance(item, dict) for item in providers):
        raise OnboardingError("model proxy returned an invalid provider list")
    updated = []
    found = False
    for item in providers:
        if item.get("name") == provider:
            item = {**item, "keys": [{"api-key": api_key}]}
            found = True
        updated.append(item)
    if not found:
        if provider == "one-nexus":
            updated.append({
                "name": "one-nexus",
                "base-url": "https://onenexus-ws.onenexus.cloud/v1",
                "keys": [{"api-key": api_key}],
                "models": [
                    {"name": "glm-5.3-sontinh", "alias": "glm-5.3-sontinh"},
                    {"name": "dsv41f-thuytinh", "alias": "dsv41f-thuytinh"},
                ],
            })
        else:
            updated.append({
                "name": "openai",
                "base-url": "https://api.openai.com/v1",
                "keys": [{"api-key": api_key}],
                "models": [{"name": "gpt-5.6-sol", "alias": "gpt-5.6-sol"}],
            })
    management_request(state, "PATCH", "/config/api-keys/openai-compatibility", updated)
    return {"provider": provider, "configured": True}


def model_proxy(request, dry):
    action = request.get("action")
    if action in {"ensure", "status-ensure"}:
        return ensure_model_proxy(request, dry)
    handlers = {
        "status": model_proxy_status,
        "claude-start": claude_start,
        "claude-callback": claude_callback,
        "claude-status": claude_status,
        "claude-cancel": claude_cancel,
        "deployment-key-create": deployment_key_create,
        "deployment-key-revoke": deployment_key_revoke,
        "deployment-key-prune": deployment_key_prune,
        "provider-key-set": provider_key_set,
    }
    handler = handlers.get(action)
    if handler is None:
        raise OnboardingError("unknown model proxy action")
    return handler(request, dry)


def person(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    return create_person(login, base, dry)


def deployment(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    repository = require(request.get("repository"), REPOSITORY, "repository")
    gateway_user, gateway_group, checkout, base = config(request)
    person_user, person_home, person_result = person_plan(login, base)
    port = used_port(request.get("usedPorts", []))
    profile = f"superagent-{deployment_id}"
    state_dir = person_home / "deployments" / deployment_id
    workspace = person_home / "worktrees" / deployment_id
    artifacts = person_home / "artifacts"
    token_dir = base / "gateway" / "tokens" / deployment_id
    unit_name = f"dsh-superagent-person-{login}-{deployment_id}.service"
    health_unit_name = f"dsh-superagent-person-{login}-{deployment_id}-health.service"
    recover_unit_name = f"dsh-superagent-person-{login}-{deployment_id}-recover.service"
    health_timer_name = f"dsh-superagent-person-{login}-{deployment_id}-health.timer"
    unit_path = Path("/etc/systemd/system") / unit_name
    health_unit_path = Path("/etc/systemd/system") / health_unit_name
    recover_unit_path = Path("/etc/systemd/system") / recover_unit_name
    health_timer_path = Path("/etc/systemd/system") / health_timer_name
    env_path = Path("/etc/dsh-superagent/deployments") / f"person-{login}-{deployment_id}.env"
    patch_path = person_home / "dsh-home" / "profiles" / profile / "cordis.patch.yml"
    url = f"http://127.0.0.1:{port}"
    if dry:
        return {
            **person_result, "id": deployment_id, "profile": profile, "repository": repository, "url": url,
            "profileTemplate": PROFILE_TEMPLATE,
            "stateDir": str(state_dir), "workspace": str(workspace), "tokenDir": str(token_dir), "unit": str(unit_path),
        "healthUnit": str(health_unit_path), "recoverUnit": str(recover_unit_path), "healthTimer": str(health_timer_path),
        }
    create_person(login, base, False)
    for path in [state_dir, workspace, artifacts]:
        path.mkdir(parents=True, exist_ok=True)
        shutil.chown(path, user=person_user, group=person_user)
    profile_dir = person_home / "dsh-home" / "profiles" / profile
    profile_command = ["runuser", "-u", person_user, "--", "env",
                       f"HOME={person_home}", f"XDG_DATA_HOME={person_home / '.local' / 'share'}",
                       f"DSH_HOME={person_home / 'dsh-home'}"]
    if not profile_has_bundle(profile_dir, WEB_APP_BUNDLE):
        run_checked([*profile_command, "dsh", "--profile", profile,
                     "--from-default-profile", PROFILE_TEMPLATE, "--dump-config"])
    run_checked([*profile_command, "dsh", "plugin", "--profile", profile, "add", f"link:{checkout}"])
    write(patch_path, profile_patch(state_dir, port), user=person_user, group=person_user)
    write(env_path, env_content(profile, url, state_dir, artifacts, person_home / "dsh-home"))
    write(unit_path, unit_content(person_user, checkout, env_path, profile, url, state_dir), mode=0o644)
    write(health_unit_path,
          health_unit_content(person_user, checkout, env_path, profile, url, state_dir, unit_name, recover_unit_name),
          mode=0o644)
    write(recover_unit_path, recover_unit_content(person_user, checkout, env_path, profile, url, state_dir), mode=0o644)
    write(health_timer_path, timer_unit_content(health_unit_name), mode=0o644)
    run_checked(["systemctl", "daemon-reload"])
    run_checked(["systemctl", "enable", "--now", unit_name])
    run_checked(["systemctl", "enable", "--now", health_timer_name])
    token = state_dir / "native-proxy-token"
    deadline = time.monotonic() + 120
    while not token.exists():
        if time.monotonic() >= deadline:
            raise OnboardingError("deployment did not create its native token in time")
        time.sleep(1)
    write(token_dir / "native-proxy-token", token.read_text(), user=gateway_user, group=gateway_group)
    return {
        "id": deployment_id, "profile": profile, "repository": repository, "url": url,
        "stateDir": str(state_dir), "workspace": str(workspace), "tokenDir": str(token_dir),
    }


def credentials(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    token = require(request.get("githubToken"), GITHUB_TOKEN, "GitHub token")
    _gateway_user, _gateway_group, _checkout, base = config(request)
    person_user, person_home, _person_result = person_plan(login, base)
    path, content = agent_wrapper(person_home, deployment_id, token, shutil.which("gh") or "/usr/bin/gh")
    if dry:
        return {"id": deployment_id, "cli": str(path)}
    create_person(login, base, False)
    write(path, content, mode=0o700, user=person_user, group=person_user)
    return {"id": deployment_id, "cli": str(path)}


def lifecycle(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    action = request.get("action")
    if action not in ACTIONS:
        raise OnboardingError("action must be start, stop, or restart")
    config(request)
    return systemctl_action(login, deployment_id, action, dry)


def status(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    config(request)
    return systemctl_status(login, deployment_id, dry)


def logs(request, dry):
    login = require(request.get("login"), LOGIN, "login")
    deployment_id = require(request.get("id"), ID, "deployment id")
    config(request)
    return journal_logs(login, deployment_id, request.get("lines"), dry)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="print the fixed plan without changing the server")
    args = parser.parse_args()
    try:
        request = json.loads(sys.stdin.read())
        operation = request.get("operation")
        if operation == "person":
            result = person(request, args.dry_run)
        elif operation == "deployment":
            result = deployment(request, args.dry_run)
        elif operation == "credentials":
            result = credentials(request, args.dry_run)
        elif operation == "lifecycle":
            result = lifecycle(request, args.dry_run)
        elif operation == "status":
            result = status(request, args.dry_run)
        elif operation == "logs":
            result = logs(request, args.dry_run)
        elif operation == "model-proxy":
            result = model_proxy(request, args.dry_run)
        else:
            raise OnboardingError("unknown operation")
    except (json.JSONDecodeError, OnboardingError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        return 1
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
