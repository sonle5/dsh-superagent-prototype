#!/bin/sh
# Restart only for the service script's recoverable status code. Codes 2 and 3 need a person,
# and the health unit already records that failure; this recovery unit did its job by declining
# to restart, so exit successfully instead of remaining failed in systemd.
set -u
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
set +e
"$SCRIPT_DIR/dsh-superagent" status "$@"
code=$?
set -e
if [ "$code" -eq 1 ]; then
  exec "$SCRIPT_DIR/dsh-superagent" restart --respect-stop "$@"
fi
if [ "$code" -eq 2 ] || [ "$code" -eq 3 ]; then
  echo "Automatic recovery skipped: the service needs operator action." >&2
  exit 0
fi
exit "$code"
