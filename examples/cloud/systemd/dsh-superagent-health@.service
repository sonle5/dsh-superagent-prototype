[Unit]
Description=DeepSeek Harness Superagent health check for %i
After=dsh-superagent@%i.service
OnFailure=dsh-superagent-recover@%i.service

[Service]
Type=oneshot
User=<fleet-user>
Group=<fleet-group>
EnvironmentFile=/etc/dsh-superagent/deployments/%i.env
WorkingDirectory=/opt/dsh-superagent
ExecStart=/opt/dsh-superagent/scripts/dsh-superagent status --profile ${DSH_SUPERAGENT_PROFILE} --url ${DSH_SUPERAGENT_URL} --state-dir ${DSH_SUPERAGENT_STATE_DIR}
