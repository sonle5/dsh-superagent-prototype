[Unit]
Description=DeepSeek Harness Superagent cloud gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<fleet-user>
Group=<fleet-group>
# The gateway itself is unprivileged; sudo raises only to the fixed onboarding helper.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
EnvironmentFile=/etc/dsh-superagent/gateway.env
WorkingDirectory=/opt/dsh-superagent
ExecStart=/usr/local/bin/dsh --profile ${DSH_SUPERAGENT_PROFILE} --no-open
StandardOutput=null
StandardError=journal
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
