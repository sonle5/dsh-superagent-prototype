[Unit]
Description=DeepSeek Harness Superagent cloud gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<fleet-user>
Group=<fleet-group>
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
EnvironmentFile=/etc/dsh-superagent/gateway.env
WorkingDirectory=/opt/dsh-superagent
ExecStart=/usr/local/bin/dsh --profile ${DSH_SUPERAGENT_PROFILE} --no-open
StandardOutput=null
StandardError=journal
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
