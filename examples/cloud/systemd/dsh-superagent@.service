[Unit]
Description=DeepSeek Harness Superagent deployment %i
After=network-online.target dsh-superagent-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
User=<fleet-user>
Group=<fleet-group>
EnvironmentFile=/etc/dsh-superagent/deployments/%i.env
WorkingDirectory=/opt/dsh-superagent
ExecStart=/opt/dsh-superagent/scripts/dsh-superagent start --profile ${DSH_SUPERAGENT_PROFILE} --url ${DSH_SUPERAGENT_URL} --state-dir ${DSH_SUPERAGENT_STATE_DIR}
ExecStop=/opt/dsh-superagent/scripts/dsh-superagent stop --profile ${DSH_SUPERAGENT_PROFILE} --url ${DSH_SUPERAGENT_URL} --state-dir ${DSH_SUPERAGENT_STATE_DIR} --stop-timeout 300
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
