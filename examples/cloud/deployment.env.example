# Copy to /etc/dsh-superagent/deployments/<deployment id>.env.
# DSH profile, loopback management URL, and state directory are not secrets.
DSH_SUPERAGENT_PROFILE=superagent-<deployment id>
DSH_SUPERAGENT_URL=http://127.0.0.1:<deployment port>
DSH_SUPERAGENT_STATE_DIR=/var/lib/dsh-superagent/deployments/<deployment id>
