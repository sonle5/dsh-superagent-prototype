# Copy to /etc/dsh-superagent/tls.env. This file contains paths and service names, not secrets.
DSH_TLS_CERT_SOURCE=/etc/letsencrypt/live/<certificate-name>/fullchain.pem
DSH_TLS_KEY_SOURCE=/etc/letsencrypt/live/<certificate-name>/<private-key-file>
DSH_TLS_OWNER=root
DSH_TLS_GROUP=<gateway-group>
DSH_TLS_GATEWAY_UNIT=dsh-superagent-gateway.service
